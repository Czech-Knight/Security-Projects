# Copy this file to .env and fill only the values you need.
# Never commit real secrets to GitHub.

# Microsoft Graph / Entra ID optional integration
MS_TENANT_ID=your-tenant-id
MS_CLIENT_ID=your-app-client-id
MS_CLIENT_SECRET=your-client-secret

# AWS optional integration
AWS_PROFILE=default
AWS_REGION=ap-southeast-2

# Azure optional integration uses Azure CLI login by default:
# az login
