{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YashSec Autopilot",
  "version": "1.0.0-rc1",
  "identifier": "com.yashsec.autopilot",
  "build": {
    "frontendDist": "../../app/static"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self' http://127.0.0.1:*; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' http://127.0.0.1:* http://localhost:*; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": false,
    "targets": [],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true }
    }
  }
}
