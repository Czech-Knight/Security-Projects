# Copy to .env for local development. Never commit .env.

# Core application
YASHSEC_HOST=127.0.0.1
YASHSEC_PORT=8787
YASHSEC_ENV=development
YASHSEC_DOCS_ENABLED=true
YASHSEC_DATA_DIR=

# Sessions and login protection
YASHSEC_SESSION_IDLE_MINUTES=60
YASHSEC_SESSION_ABSOLUTE_HOURS=12
YASHSEC_LOGIN_WINDOW_MINUTES=15
YASHSEC_LOGIN_MAX_FAILURES=5
YASHSEC_LOCKOUT_MINUTES=15

# Scanner orchestration
YASHSEC_MAX_SCAN_WORKERS=2
YASHSEC_MAX_REQUEST_BYTES=2097152
YASHSEC_ALLOW_REMOTE_DYNAMIC_SCAN=false

# Local Ollama (privacy-first default)
YASHSEC_AI_PROVIDER=ollama
YASHSEC_OLLAMA_URL=http://127.0.0.1:11434
YASHSEC_OLLAMA_MODEL=qwen3:8b
YASHSEC_AIRLLM_URL=http://127.0.0.1:8765

# Remote Ollama Cloud (opt-in only)
# Never put the API key in this file when deploying from GitHub.
# Store OLLAMA_API_KEY in the hosting provider's encrypted secret store.
YASHSEC_ALLOW_CLOUD_AI=false
YASHSEC_CLOUD_AI_HOSTS=ollama.com
OLLAMA_API_KEY=

# Public portfolio demo. Keep false for normal/local installs.
YASHSEC_DEMO_MODE=false
YASHSEC_DEMO_AI_REQUESTS_PER_HOUR=20
YASHSEC_DEMO_SESSION_REQUESTS_PER_HOUR=30
